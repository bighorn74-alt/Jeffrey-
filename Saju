<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>사주 4기둥 만세력 & 일진 나침반</title>
  <style>
    :root {
      --bg: #090d16;
      --card-bg: #111827;
      --border: #1f2937;
      --text: #f3f4f6;
      --subtext: #9ca3af;
      --cyan: #38bdf8;
      --emerald: #34d399;
      --amber: #fbbf24;
      --rose: #f43f5e;
      --blue: #60a5fa;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding: 14px; font-size: 13px; line-height: 1.5; max-width: 480px; margin: 0 auto; }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 10px; margin-bottom: 12px; }
    .title-sub { font-size: 10px; color: var(--cyan); font-weight: 700; letter-spacing: 1px; }
    .title-main { font-size: 16px; font-weight: 800; color: #fff; }
    
    .card { background-color: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 13px; margin-bottom: 11px; }
    .scene-title { font-size: 11px; font-weight: 700; color: var(--amber); margin-bottom: 4px; }
    .scene-body { font-size: 12.5px; color: #f1f5f9; font-style: italic; line-height: 1.6; }
    
    .input-group { display: grid; grid-template-columns: 2fr 1fr; gap: 8px; margin-top: 8px; }
    input, select, button { background: #0b1120; border: 1px solid var(--border); color: #fff; padding: 8px 10px; border-radius: 6px; font-size: 12px; outline: none; }
    input:focus, select:focus { border-color: var(--cyan); }
    .btn-calc { background: #0284c7; color: #fff; font-weight: 700; cursor: pointer; border: none; width: 100%; margin-top: 8px; padding: 9px; border-radius: 6px; }
    .btn-calc:hover { background: #0369a1; }

    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 8px; text-align: center; }
    .mini-box { background: #0b1120; border: 1px solid var(--border); border-radius: 6px; padding: 8px 4px; }
    .mini-label { font-size: 9.5px; color: var(--subtext); }
    .mini-val { font-size: 14px; font-weight: 800; margin: 2px 0; }
    
    .gauge-container { width: 100%; background: #1f2937; height: 8px; border-radius: 999px; overflow: hidden; margin: 8px 0 4px; }
    .gauge-bar { height: 100%; transition: width 0.4s ease; }
    
    .risk-item { padding: 5px 0; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 6px; font-size: 11.5px; }
    .risk-num { color: var(--rose); font-weight: 700; font-size: 11px; flex-shrink: 0; }
  </style>
</head>
<body>

  <!-- 헤더 -->
  <div class="header">
    <div>
      <div class="title-sub">JEFFREY SAJU NAVIGATOR</div>
      <div class="title-main">사주 4기둥 분석 & 일진 나침반</div>
    </div>
    <div id="target-badge" style="font-size: 10px; background: #1e293b; border: 1px solid #334155; padding: 3px 8px; border-radius: 4px; color: var(--cyan); font-weight: 700;">대기 중 (0000년 00월 00일)</div>
  </div>

  <!-- [1단계] 생년월일시 입력 폼 (0000년 00월 00일 초기화) -->
  <div class="card" style="border-color: #0369a1;">
    <div style="font-size: 11px; font-weight: 700; color: var(--cyan);">⚙️ [1단계] 생년월일시 입력 (양력 기준)</div>
    <div class="input-group">
      <input type="date" id="input-birth-date" value="">
      <select id="input-birth-hour">
        <option value="" selected disabled>태어난 시간 선택</option>
        <option value="0">자시 (23:30~01:29)</option>
        <option value="1">축시 (01:30~03:29)</option>
        <option value="2">인시 (03:30~05:29)</option>
        <option value="3">묘시 (05:30~07:29)</option>
        <option value="4">진시 (07:30~09:29)</option>
        <option value="5">사시 (09:30~11:29)</option>
        <option value="6">오시 (11:30~13:29)</option>
        <option value="7">미시 (13:30~15:29)</option>
        <option value="8">신시 (15:30~17:29)</option>
        <option value="9">유시 (17:30~19:29)</option>
        <option value="10">술시 (19:30~21:29)</option>
        <option value="11">해시 (21:30~23:29)</option>
      </select>
    </div>
    <button class="btn-calc" onclick="calculateSajuAndRender()">사주 분석 및 일진 계산 실행</button>
  </div>

  <!-- [2단계] 결과 화면: 상황을 여는 장면 -->
  <div class="card" style="border-left: 3px solid var(--amber);">
    <div class="scene-title">🐉 상황을 여는 장면</div>
    <div id="scene-text" class="scene-body">생년월일시를 입력하고 [실행] 버튼을 누르면 천문과 일진의 형국이 펼쳐집니다.</div>
  </div>

  <!-- 오늘 일진 & 주의 지수 (1~10) -->
  <div class="card">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <div class="mini-label">오늘의 일진</div>
        <div id="today-ganji" style="font-size: 20px; font-weight: 900; color: #fff;">-</div>
        <div id="today-elements" style="font-size: 11px; color: var(--subtext);">-</div>
      </div>
      <div style="text-align: right;">
        <div class="mini-label">오늘 주의 지수</div>
        <div style="font-size: 24px; font-weight: 900;" id="score-text">- <span style="font-size: 12px; color: var(--subtext);">/ 10</span></div>
        <div id="status-badge" style="font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; display: inline-block; background: #1e293b; color: var(--subtext);">대기</div>
      </div>
    </div>
    <div class="gauge-container">
      <div id="gauge-fill" class="gauge-bar" style="width: 0%; background: var(--amber);"></div>
    </div>
    <div style="display: flex; justify-content: space-between; font-size: 9px; color: var(--subtext);">
      <span>1 (순항·길일)</span>
      <span>5 (평이)</span>
      <span>10 (경계·10개이상 조심)</span>
    </div>
  </div>

  <!-- 도출된 사주 4기둥 (년·월·일·시) -->
  <div class="card">
    <div class="mini-label" style="font-weight: 700; color: #cbd5e1;">🏛️ 분석 대상 사주 4기둥 (四柱 八字)</div>
    <div class="grid-4">
      <div class="mini-box">
        <div class="mini-label">년주(가문/배경)</div>
        <div class="mini-val" id="disp-year" style="color: var(--cyan);">0000년</div>
        <div class="mini-label" id="disp-year-info">-</div>
      </div>
      <div class="mini-box">
        <div class="mini-label">월주(사회/직장)</div>
        <div class="mini-val" id="disp-month" style="color: var(--emerald);">00월</div>
        <div class="mini-label" id="disp-month-info">-</div>
      </div>
      <div class="mini-box" style="border-color: #0284c7;">
        <div class="mini-label">일주(본인/기질)</div>
        <div class="mini-val" id="disp-day" style="color: var(--blue);">00일</div>
        <div class="mini-label" id="disp-day-info">-</div>
      </div>
      <div class="mini-box">
        <div class="mini-label">시주(말년/결실)</div>
        <div class="mini-val" id="disp-time" style="color: var(--amber);">00시</div>
        <div class="mini-label" id="disp-time-info">-</div>
      </div>
    </div>
  </div>

  <!-- 인물 성격 및 기질 분석 -->
  <div class="card">
    <div style="font-weight: 700; color: var(--emerald); font-size: 12px; margin-bottom: 6px;">👤 타고난 성격 및 기질 분석</div>
    <div id="personality-text" style="font-size: 12px; color: #cbd5e1; line-height: 1.6;">생년월일시 입력 후 성격 분석이 도출됩니다.</div>
  </div>

  <!-- 원국별 상세 상호작용 리포트 -->
  <div class="card">
    <div style="font-weight: 700; color: var(--cyan); margin-bottom: 8px; font-size: 12px;">🧭 년·월·일주와 오늘 일진의 상호작용</div>
    <div id="pillar-report" style="display: flex; flex-direction: column; gap: 7px;">
      <div style="background: #0b1120; padding: 7px 9px; border-radius: 6px; border: 1px solid var(--border); color: var(--subtext);">
        분석 대기 중입니다.
      </div>
    </div>
  </div>

  <!-- 핵심 경계 체크리스트 -->
  <div class="card" style="border-color: rgba(244, 63, 94, 0.3);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
      <div style="font-weight: 700; color: var(--rose); font-size: 12px;">⚠️ 오늘의 핵심 경계 리스트</div>
      <div id="risk-count" style="font-size: 10px; color: var(--rose); background: rgba(244, 63, 94, 0.1); padding: 1px 6px; border-radius: 99px;">주의 0건</div>
    </div>
    <div id="risk-list">
      <div class="risk-item" style="color: var(--subtext);">생년월일시를 입력하면 주의 항목이 계산됩니다.</div>
    </div>
  </div>

  <script>
    const stems = ["갑", "을", "병", "정", "무", "기", "경", "신", "임", "계"];
    const branches = ["자", "축", "인", "묘", "진", "사", "오", "미", "신", "유", "술", "해"];
    const stemHanja = {"갑":"甲","을":"乙","병":"丙","정":"丁","무":"戊","기":"己","경":"庚","신":"辛","임":"壬","계":"癸"};
    const branchHanja = {"자":"子","축":"丑","인":"寅","묘":"卯","진":"辰","사":"巳","오":"午","미":"未","신":"申","유":"酉","술":"戌","해":"亥"};
    const stemElements = {"갑":"목","을":"목","병":"화","정":"화","무":"토","기":"토","경":"금","신":"금","임":"수","계":"수"};
    const branchElements = {"자":"수","축":"토","인":"목","묘":"목","진":"토","사":"화","오":"화","미":"토","신":"금","유":"금","술":"토","해":"수"};

    function getTodayPillar() {
      const baseDate = new Date(2024, 0, 1);
      const today = new Date();
      const diff = Math.floor((today - baseDate) / (1000 * 60 * 60 * 24));
      const sIdx = (diff % 10 + 10) % 10;
      const bIdx = (diff % 12 + 12) % 12;
      return {
        stem: stems[sIdx],
        branch: branches[bIdx],
        ganji: stems[sIdx] + branches[bIdx],
        hanja: stemHanja[stems[sIdx]] + branchHanja[branches[bIdx]],
        sElem: stemElements[stems[sIdx]],
        bElem: branchElements[branches[bIdx]]
      };
    }

    function calculateUserPillars(dateStr, hourIdx) {
      const parts = dateStr.split("-");
      const y = parseInt(parts[0], 10);
      const m = parseInt(parts[1], 10);
      const d = parseInt(parts[2], 10);

      const targetDate = new Date(y, m - 1, d);
      const baseDate = new Date(2024, 0, 1);
      const diffDays = Math.floor((targetDate - baseDate) / (1000 * 60 * 60 * 24));
      const dayStemIdx = (diffDays % 10 + 10) % 10;
      const dayBranchIdx = (diffDays % 12 + 12) % 12;

      let yearCalc = y;
      if (m < 2 || (m === 2 && d < 4)) yearCalc = y - 1;
      const yearStemIdx = (yearCalc - 4) % 10;
      const yearBranchIdx = (yearCalc - 4) % 12;

      const monthBranchIdx = (m + 1) % 12;
      const monthStemIdx = ((yearStemIdx % 5) * 2 + (monthBranchIdx >= 2 ? monthBranchIdx - 2 : monthBranchIdx + 10)) % 10;

      const timeBranchIdx = hourIdx !== "" && hourIdx !== null ? parseInt(hourIdx, 10) : 0;
      const timeStemIdx = ((dayStemIdx % 5) * 2 + timeBranchIdx) % 10;

      return {
        year: { stem: stems[(yearStemIdx + 10) % 10], branch: branches[(yearBranchIdx + 12) % 12] },
        month: { stem: stems[(monthStemIdx + 10) % 10], branch: branches[monthBranchIdx] },
        day: { stem: stems[dayStemIdx], branch: branches[dayBranchIdx] },
        time: { stem: stems[timeStemIdx], branch: branches[timeBranchIdx] }
      };
    }

    const metaSubject = {
      "갑": "우뚝 솟은 거대한 푸른 소나무(甲木)",
      "을": "바위틈을 뚫고 피어난 강인한 덩굴화초(乙木)",
      "병": "천하를 밝게 비추는 찬란한 태양(丙火)",
      "정": "어둠을 사르는 따뜻하고 신성한 모닥불(丁火)",
      "무": "비바람을 막아서는 웅장한 황토산(戊土)",
      "기": "생명을 품어 기르는 비옥한 대지(己土)",
      "경": "단단한 바위산과 번뜩이는 장군의 보검(庚金)",
      "신": "정밀하게 세공된 빛나는 다이아몬드(辛金)",
      "임": "도도하게 흐르는 깊고 방대한 밤바다(壬水)",
      "계": "온 세상을 조용히 적시는 지혜로운 봄비(癸水)"
    };

    function generateDynamicScene(dayStem, dayBranch, today) {
      const myElem = stemElements[dayStem];
      const todayElem = today.bElem;
      const sub = metaSubject[dayStem] || "운명의 주인공";
      const gName = `${today.stem}${today.branch}(${today.hanja})`;

      const isChung = (
        (dayBranch === "자" && today.branch === "오") || (dayBranch === "오" && today.branch === "자") ||
        (dayBranch === "인" && today.branch === "신") || (dayBranch === "신" && today.branch === "인") ||
        (dayBranch === "사" && today.branch === "해") || (dayBranch === "해" && today.branch === "사") ||
        (dayBranch === "묘" && today.branch === "유") || (dayBranch === "유" && today.branch === "묘") ||
        (dayBranch === "진" && today.branch === "술") || (dayBranch === "술" && today.branch === "진") ||
        (dayBranch === "축" && today.branch === "미") || (dayBranch === "미" && today.branch === "축")
      );

      if (isChung) {
        return `"${sub}이(가) 발을 딛고 서 있는 자리(일지 ${dayBranch})가 오늘의 일진(${gName})과 정면으로 부딪치며(沖), 거센 파도와 바람 앞에 섣부른 돌진을 멈추고 견고한 수비의 방패 뒤로 물러서 형세를 관망해야 하는 경계의 형국입니다."`;
      }

      if ((dayBranch === "자" && today.branch === "묘") || (dayBranch === "축" && (today.branch === "술" || today.branch === "미"))) {
        return `"${sub}의 주변으로 얽히고설킨 가지와 흙더미(형살·刑殺)가 마찰을 일으키니, 윗선과 동료의 사소한 시비나 규율의 덫에 걸리지 않도록 오직 명확한 데이터와 침묵으로 틈새를 돌파해야 하는 형국입니다."`;
      }

      if (myElem === "수" && todayElem === "화") {
        return `"${sub} 위로 오늘의 찬란한 온기(재성·${gName})가 내려앉아, 꽁꽁 얼어붙었던 수면을 녹여내며 황금빛 재물과 현실적 기회의 결실을 활짝 열어젖히는 순항의 형국입니다."`;
      } else if (myElem === "수" && todayElem === "토") {
        return `"${sub} 앞을 단단하고 거대한 제방(관성·${gName})이 가로막아서니, 무리하게 맞부딪히기보다 식상(기획과 언어)의 유연한 물길로 우회하여 성과를 낚아채야 하는 전략적 형국입니다."`;
      } else if (myElem === "수" && todayElem === "금") {
        return `"${sub}의 상류에서 맑고 견고한 금빛 바위(인성·${gName})가 솟아올라 마르지 않는 수원지를 열어주니, 깊은 통찰력과 문서의 힘으로 명예를 굳건히 다지는 길한 형국입니다."`;
      } else if (myElem === "화" && todayElem === "수") {
        return `"${sub}을 향해 차가운 밤비와 강풍(관성·${gName})이 몰아치는 날이니, 감정의 불꽃을 과하게 피우지 않고 내면의 등불을 차분히 갈무리해야 하는 인내의 형국입니다."`;
      } else if (myElem === "화" && todayElem === "목") {
        return `"${sub}에게 든든한 땔나무(인성·${gName})가 공급되어, 가슴속에 품었던 열정과 기획의 불길이 하늘을 향해 당당하게 치솟는 활력의 형국입니다."`;
      } else if (myElem === "목" && todayElem === "화") {
        return `"${sub}의 푸른 가지마다 화려한 꽃망울(식상·${gName})이 활짝 피어오르니, 내 안의 창의력과 기획이 세상 사람들의 시선을 사로잡는 도약의 형국입니다."`;
      } else if (myElem === "금" && todayElem === "토") {
        return `"${sub}을 품어 안은 두터운 황토 대지(인성·${gName})가 든든한 보호막이 되어주니, 주변의 신용과 공적인 인프라를 바탕으로 안정된 결재를 얻어내는 안착의 형국입니다."`;
      } else {
        return `"${sub}이(가) 자신과 닮은 기운(${gName})을 만나 내면의 주체성과 고집이 함께 솟구치는 날이니, 독단을 피하고 경청과 데이터로 유연하게 보폭을 맞춰야 하는 형국입니다."`;
      }
    }

    function calculateSajuAndRender() {
      const birthDate = document.getElementById('input-birth-date').value;
      const birthHour = document.getElementById('input-birth-hour').value;
      
      if (!birthDate) {
        alert("생년월일을 입력해 주세요.");
        return;
      }

      const p = calculateUserPillars(birthDate, birthHour);
      const today = getTodayPillar();

      const fmt = (col) => `${col.stem}${col.branch} (${stemHanja[col.stem]}${branchHanja[col.branch]})`;
      document.getElementById('disp-year').innerText = fmt(p.year);
      document.getElementById('disp-year-info').innerText = `${stemElements[p.year.stem]} · ${branchElements[p.year.branch]}`;
      document.getElementById('disp-month').innerText = fmt(p.month);
      document.getElementById('disp-month-info').innerText = `${stemElements[p.month.stem]} · ${branchElements[p.month.branch]}`;
      document.getElementById('disp-day').innerText = fmt(p.day);
      document.getElementById('disp-day-info').innerText = `${stemElements[p.day.stem]} · ${branchElements[p.day.branch]}`;
      document.getElementById('disp-time').innerText = fmt(p.time);
      document.getElementById('disp-time-info').innerText = `${stemElements[p.time.stem]} · ${branchElements[p.time.branch]}`;

      document.getElementById('target-badge').innerText = `${p.day.stem}${p.day.branch} (${stemHanja[p.day.stem]}${branchHanja[p.day.branch]}) 분석`;

      let pDesc = "";
      if (p.day.stem === "임" || p.day.stem === "계") {
        pDesc = `• <strong>본질:</strong> 유연하고 방대한 물(水)의 본원을 타고나 직관력과 깊은 지혜, 데이터 및 형세를 꿰뚫는 분석력이 뛰어납니다[span_6](start_span)[span_6](end_span)[span_7](start_span)[span_7](end_span).\n• <strong>성향:</strong> 겉으로는 유연하고 침착해 보이지만 내면의 주체성과 자존심이 대단히 강하며, 불합리한 통제나 비효율을 극도로 꺼리는 전략가 기질입니다[span_8](start_span)[span_8](end_span)[span_9](start_span)[span_9](end_span).`;
      } else if (p.day.stem === "경" || p.day.stem === "신") {
        pDesc = `• <strong>본질:</strong> 날카롭고 견고한 금(金)의 기운으로, 공과 사의 구분이 명확하고 디테일에 강한 칼날·보석의 성정을 지녔습니다[span_10](start_span)[span_10](end_span)[span_11](start_span)[span_11](end_span).\n• <strong>성향:</strong> 결단력과 완벽주의가 강해 흐트러진 모습을 보이지 않으며, 자기 영역과 전문성이 보장되어야 직성이 풀립니다[span_12](start_span)[span_12](end_span)[span_13](start_span)[span_13](end_span).`;
      } else if (p.day.stem === "갑" || p.day.stem === "을") {
        pDesc = `• <strong>본질:</strong> 솟구치는 생명력과 진취성을 지닌 목(木) 기운으로, 기획력과 창의성이 번뜩입니다[span_14](start_span)[span_14](end_span)[span_15](start_span)[span_15](end_span).\n• <strong>성향:</strong> 친화력과 유연함이 뛰어나며 끊임없이 무언가를 추진하고 배우려는 향상심이 높습니다[span_16](start_span)[span_16](end_span)[span_17](start_span)[span_17](end_span).`;
      } else if (p.day.stem === "병" || p.day.stem === "정") {
        pDesc = `• <strong>본질:</strong> 찬란한 태양과 열정의 불꽃(火)으로, 솔직하고 화끈하며 자기표현이 명확합니다[span_18](start_span)[span_18](end_span)[span_19](start_span)[span_19](end_span).\n• <strong>성향:</strong> 예의와 명예를 중시하며 목표가 정해지면 폭발적인 에너지를 뿜어내는 적극파입니다[span_20](start_span)[span_20](end_span)[span_21](start_span)[span_21](end_span).`;
      } else {
        pDesc = `• <strong>본질:</strong> 묵직하고 신중한 흙(土)의 기운으로, 신용과 중심을 중시하는 포용력을 가집니다[span_22](start_span)[span_22](end_span)[span_23](start_span)[span_23](end_span).\n• <strong>성향:</strong> 생각이 깊고 우직하여 쉽게 흔들리지 않으나, 고집이 세고 변화에 신중한 편입니다[span_24](start_span)[span_24](end_span)[span_25](start_span)[span_25](end_span).`;
      }
      document.getElementById('personality-text').innerHTML = pDesc.replace(/\n/g, "<br>");

      let score = 5;
      let risks = [];
      let dayImpact = "";
      let monthImpact = "";
      let yearImpact = "";

      const myB = p.day.branch;
      const tb = today.branch;
      if ((myB === "자" && tb === "오") || (myB === "오" && tb === "자")) {
        score = 9;
        risks.push("자오충(子午沖): 일지와 정면충돌하여 감정 과열, 충동적 언행 및 혈압·피로 급증 주의[span_26](start_span)[span_26](end_span)[span_27](start_span)[span_27](end_span)");
        dayImpact = "일지가 충(沖)을 맞아 심리적 안정감이 흔들리고 돌발 변수가 발생하기 쉽습니다[span_28](start_span)[span_28](end_span)[span_29](start_span)[span_29](end_span).";
      } else if ((myB === "인" && tb === "신") || (myB === "신" && tb === "인")) {
        score = 8;
        risks.push("인신충(寅申沖): 이동수, 신체 접촉사고, 업무 프로세스의 급격한 노선 변경 주의[span_30](start_span)[span_30](end_span)[span_31](start_span)[span_31](end_span)");
        dayImpact = "역마성 충돌로 분주하지만 실속 없이 피로해질 수 있습니다[span_32](start_span)[span_32](end_span).";
      } else if ((myB === "사" && tb === "해") || (myB === "해" && tb === "사")) {
        score = 8;
        risks.push("사해충(巳亥沖): 안식처의 자리 변동, 감정 기복 및 환경의 급격한 전환 주의[span_33](start_span)[span_33](end_span)[span_34](start_span)[span_34](end_span)");
        dayImpact = "일지의 충으로 인해 서 있던 자리가 흔들리고 이동수가 발동합니다[span_35](start_span)[span_35](end_span)[span_36](start_span)[span_36](end_span).";
      } else if ((myB === "진" && tb === "술") || (myB === "술" && tb === "진")) {
        score = 8;
        risks.push("진술충(辰戌沖): 서류, 계약 조항 재검토 및 토(土)끼리의 충돌로 인한 과부하 주의[span_37](start_span)[span_37](end_span)[span_38](start_span)[span_38](end_span)");
        dayImpact = "문서와 계약의 미세 조정이 필요하며 업무 피로도가 집중됩니다[span_39](start_span)[span_39](end_span).";
      } else if ((myB === "축" && tb === "미") || (myB === "미" && tb === "축")) {
        score = 9;
        risks.push("축미충(丑未沖): 차가운 흙과 뜨거운 흙의 충돌, 기존 규율 파괴 및 부서 갈등 주의[span_40](start_span)[span_40](end_span)[span_41](start_span)[span_41](end_span)");
        dayImpact = "지장간이 요동쳐 속 시끄러운 상황이 발생하기 쉬우니 신중하십시오[span_42](start_span)[span_42](end_span)[span_43](start_span)[span_43](end_span).";
      } else if (myB === "자" && tb === "미") {
        score = 9;
        risks.push("자미원진(子未怨嗔): 상대방의 비효율적 일 처리에 대한 내적 답답함과 소통 마찰 주의[span_44](start_span)[span_44](end_span)[span_45](start_span)[span_45](end_span)");
        dayImpact = "원진의 예민함으로 사소한 오해가 커질 수 있으니 말을 아끼십시오[span_46](start_span)[span_46](end_span)[span_47](start_span)[span_47](end_span).";
      } else if (today.bElem === "화" && (p.day.stem === "임" || p.day.stem === "계")) {
        score = 2;
        risks.push("화(재성) 유입에 따른 활동성 증가 속 가벼운 수분 부족 관리[span_48](start_span)[span_48](end_span)[span_49](start_span)[span_49](end_span)");
        dayImpact = "원국에 필요한 온기(火)가 들어와 결실과 대인관계의 주도권을 쥡니다[span_50](start_span)[span_50](end_span)[span_51](start_span)[span_51](end_span).";
      } else {
        score = 5;
        risks.push("과도한 고집이나 독단 경계, 경청과 팩트 위주의 문서 정리 권장[span_52](start_span)[span_52](end_span)[span_53](start_span)[span_53](end_span)");
        dayImpact = "평이한 흐름이나 정해진 루틴을 지킬 때 가장 안전합니다[span_54](start_span)[span_54](end_span).";
      }

      yearImpact = `오늘의 ${today.bElem} 기운이 년주(${p.year.stem}${p.year.branch})의 기반 환경을 자극함[span_55](start_span)[span_55](end_span)`;
      monthImpact = `오늘의 ${today.sElem} 기운이 월주(${p.month.stem}${p.month.branch})의 직장/사회 활동 반경과 교차함[span_56](start_span)[span_56](end_span)[span_57](start_span)[span_57](end_span)`;

      score = Math.max(1, Math.min(10, score));

      document.getElementById('today-ganji').innerText = `${today.ganji}일 (${today.hanja})`;
      document.getElementById('today-elements').innerText = `천간 ${today.sElem} / 지지 ${today.bElem}`;
      document.getElementById('score-text').innerHTML = `${score} <span style="font-size: 12px; color: var(--subtext);">/ 10</span>`;

      const fill = document.getElementById('gauge-fill');
      const badge = document.getElementById('status-badge');
      fill.style.width = (score * 10) + "%";

      if (score <= 3) {
        fill.style.background = "var(--emerald)";
        document.getElementById('score-text').style.color = "var(--emerald)";
        badge.innerText = "안전 순항 (길일)";
        badge.style.background = "rgba(52, 211, 153, 0.2)";
        badge.style.color = "var(--emerald)";
      } else if (score <= 6) {
        fill.style.background = "var(--amber)";
        document.getElementById('score-text').style.color = "var(--amber)";
        badge.innerText = "주의 요망 (평이)";
        badge.style.background = "rgba(251, 191, 36, 0.2)";
        badge.style.color = "var(--amber)";
      } else {
        fill.style.background = "var(--rose)";
        document.getElementById('score-text').style.color = "var(--rose)";
        badge.innerText = "집중 경계 (흉일)";
        badge.style.background = "rgba(244, 63, 94, 0.2)";
        badge.style.color = "var(--rose)";
      }

      const dynamicScene = generateDynamicScene(p.day.stem, p.day.branch, today);
      document.getElementById('scene-text').innerText = dynamicScene;

      document.getElementById('pillar-report').innerHTML = `
        <div style="background: #0b1120; padding: 7px 9px; border-radius: 6px; border: 1px solid var(--border);">
          <span style="color: var(--cyan); font-weight: 700;">🏛️ 년주 작용:</span> ${yearImpact}
        </div>
        <div style="background: #0b1120; padding: 7px 9px; border-radius: 6px; border: 1px solid var(--border);">
          <span style="color: var(--emerald); font-weight: 700;">💼 월주 작용:</span> ${monthImpact}
        </div>
        <div style="background: #0b1120; padding: 7px 9px; border-radius: 6px; border: 1px solid var(--border);">
          <span style="color: var(--blue); font-weight: 700;">🌊 일주 작용:</span> ${dayImpact}
        </div>
      `;

      document.getElementById('risk-count').innerText = `주의 ${risks.length}건`;
      document.getElementById('risk-list').innerHTML = risks.map((r, i) => `
        <div class="risk-item">
          <span class="risk-num">#${i+1}</span>
          <span>${r}</span>
        </div>
      `).join('');
    }

    // 초기 화면에서는 오늘 일진 간지만 표시하고 사용자 사주 계산은 대기 상태로 유지
    const initToday = getTodayPillar();
    document.getElementById('today-ganji').innerText = `${initToday.ganji}일 (${initToday.hanja})`;
    document.getElementById('today-elements').innerText = `천간 ${initToday.sElem} / 지지 ${initToday.bElem}`;
  </script>
</body>
</html>
